{
  "name": "fedsocial-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "FedSocial V2: Personalized Content Recommendation with Federated Learning",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/clean-ports.js 3000 4000 && concurrently -k -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "node scripts/clean-ports.js 3000 && npm run dev --workspace=apps/web",
    "dev:api": "node scripts/clean-ports.js 4000 && npm run dev --workspace=apps/api",
    "clean:ports": "node scripts/clean-ports.js 3000 4000",
    "fl:logs": "node scripts/fl-logs.js",
    "fl:monitor": "node scripts/fl-monitor.js",
    "fl:agent": "python clients/local-agent/agent_daemon.py",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "lint": "npm run lint --workspaces",
    "test:api": "npm run test --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api",
    "test:ml": ".venv\\Scripts\\pytest.exe ml/tests -v"
  },
  "keywords": [
    "federated-learning",
    "recsys",
    "privacy-preserving",
    "nextjs",
    "express",
    "flower",
    "pytorch"
  ],
  "author": "FedSocial Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
